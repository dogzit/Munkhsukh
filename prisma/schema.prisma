generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(nanoid())
  name        String       @unique
  // Хэрэглэгчийн эрх: USER | ADMIN
  role        String       @default("USER")
  // Бүртгэлийн төлөв: PENDING (админ зөвшөөрөөгүй) | APPROVED
  status      String       @default("APPROVED")
  // Ангийн салаа: 1 | 2 | 3 (сонгоогүй бол null)
  branch      Int?
  pinHash     String       @unique
  pinSalt     String
  avatar      String?
  bio         String?
  instagram   String?
  phone       String?
  email       String?
  birthDate   DateTime?
  fullName    String?
  createdAt   DateTime     @default(now())
  Session     Session[]
  todos       Todo[]
  likes       Like[]
  comments    Comment[]
  busBookings BusBooking[]
  pushSubs    PushSubscription[]
  branchPosts BranchPost[]
}

model Todo {
  id        Int      @id @default(autoincrement())
  task      String
  completed Boolean  @default(false)
  userName  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userName], references: [name], onDelete: Cascade)
}

model Hwork {
  id      String   @id @default(cuid())
  title   String
  image   String?
  subject String
  date    DateTime
  images  String[] @default([])
  checks  HworkCheck[]
}

// Хэрэглэгч бүрийн хийсэн даалгаврын тэмдэглээ (leaderboard-ийн эх үүсвэр)
model HworkCheck {
  id        String   @id @default(nanoid())
  hworkId   String
  userName  String
  createdAt DateTime @default(now())
  hwork     Hwork    @relation(fields: [hworkId], references: [id], onDelete: Cascade)

  @@unique([hworkId, userName])
  @@index([userName])
}

model DutySchedule {
  id        String   @id @default(nanoid())
  date      DateTime @unique
  names     String[] @default([])
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model Timetable {
  id           String   @id @default(nanoid())
  day          Day
  lessonNumber Int
  subject      String
  createdAt    DateTime @default(now())

  @@unique([day, lessonNumber])
}

model Session {
  token     String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// --- Chat ---
model ChatMessage {
  id        String   @id @default(nanoid())
  userName  String
  text      String
  image     String?
  replyToId String?
  reaction  String[] @default([])
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// --- News/Photo Feed ---
model Post {
  id        String    @id @default(nanoid())
  userName  String
  text      String
  images    String[]  @default([])
  createdAt DateTime  @default(now())
  likes     Like[]
  comments  Comment[]

  @@index([createdAt])
}

model Like {
  id       String @id @default(nanoid())
  postId   String
  userName String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userName], references: [name], onDelete: Cascade)

  @@unique([postId, userName])
}

model Comment {
  id        String   @id @default(nanoid())
  postId    String
  userName  String
  text      String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userName], references: [name], onDelete: Cascade)

  @@index([postId, createdAt])
}

model BusLayout {
  id        String   @id @default(nanoid())
  seatId    String   @unique
  x         Float
  y         Float
  isPremium Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BusBooking {
  id        String    @id @default(nanoid())
  seatId    String    @unique
  userName  String
  email     String
  status    String    @default("APPROVED") // PENDING | APPROVED | BOARDED
  qrToken   String    @unique
  boardedAt DateTime?
  boardedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userName], references: [name], onDelete: Cascade)

  @@index([qrToken])
}

model EmailOtp {
  id        String   @id @default(nanoid())
  email     String
  userName  String?
  purpose   String   @default("BUS_BOOKING") // BUS_BOOKING | SIGNUP | FORGOT_PIN
  codeHash  String
  codeSalt  String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([userName, email])
  @@index([expiresAt])
}

// --- App settings (key-value) ---
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// --- Notifications ---
model Notification {
  id        String   @id @default(nanoid())
  userName  String
  title     String
  body      String?
  icon      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userName, read])
  @@index([createdAt])
}

// --- Салааны хэсэг: зөвхөн тухайн салааныхан харна ---
model BranchPost {
  id        String   @id @default(nanoid())
  branch    Int
  userName  String
  text      String
  images    String[] @default([])
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userName], references: [name], onDelete: Cascade)

  @@index([branch, createdAt])
}

// --- Web Push (утас руу мэдэгдэл) ---
model PushSubscription {
  id        String   @id @default(nanoid())
  userName  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userName], references: [name], onDelete: Cascade)

  @@index([userName])
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}
